# LabMemory Platform 本地开发配置示例
# 复制为 .env 后按需修改

# 数据库：默认 SQLite 文件库（生产可切 postgresql://user:pwd@host:5432/labmemory）
DATABASE_URL=sqlite:///./data/labmemory.db

# 服务
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
LOG_LEVEL=INFO
CORS_ORIGINS=*

# 飞书编排器调用 /v1/* 接口的鉴权密钥（生产请至少 32 字符）
PLATFORM_API_KEY=dev-platform-api-key-please-rotate

# 平台用户 JWT 签名密钥（生产请至少 32 字符）
JWT_SECRET=dev-jwt-secret-please-rotate
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 飞书编排器地址（用于平台请求飞书侧执行 create_task 等动作）
FEISHU_ORCHESTRATOR_BASE_URL=http://localhost:8080
FEISHU_ORCHESTRATOR_MODE=mock

# === 飞书 UUAP / OAuth 免登（网页应用登录）===
# 接入方式：飞书开放平台「网页应用」OAuth 2.0（UUAP 统一认证免登）。
# real 模式：在 open.feishu.cn 创建自建应用，配置以下 App ID/Secret，
#   并在「安全设置-重定向 URL」登记 FEISHU_OAUTH_REDIRECT_URI。
# mock 模式：无需真实凭据，登录页走「模拟飞书登录」本地验证自动注册流程。
FEISHU_OAUTH_MODE=mock
FEISHU_OAUTH_APP_ID=
FEISHU_OAUTH_APP_SECRET=
FEISHU_OAUTH_REDIRECT_URI=http://localhost:8081/api/auth/feishu/callback
# 授权页 / token / 用户信息端点（默认飞书公开域名，可替换为 UUAP 内部域名）
FEISHU_OAUTH_AUTHORIZE_URL=https://accounts.feishu.cn/open-apis/authen/v1/authorize
FEISHU_OAUTH_TOKEN_URL=https://open.feishu.cn/open-apis/authen/v2/oauth/token
FEISHU_OAUTH_USERINFO_URL=https://open.feishu.cn/open-apis/authen/v1/user_info
# 授权申请的用户权限（最小集）
FEISHU_OAUTH_SCOPE=contact:user.base:readonly contact:user.employee:readonly

# === UUAP 自动注册 ===
# 新飞书用户首次登录自动注册，默认最低权限角色：viewer（只读，无成员关系时不可见任何实验）
UUAP_AUTO_REGISTER_ROLE=viewer
# 是否保留用户名密码登录（管理员/演示兜底）；false 时仅飞书登录
PASSWORD_LOGIN_ENABLED=true


# === 可信知识问答 RAG ===
# Qwen 嵌入模型（DashScope 兼容 OpenAI 接口）。留空则降级到 hash 伪向量。
QWEN_API_KEY=
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_EMBEDDING_DIM=1024
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek 对话模型（兼容 OpenAI SDK）。留空或 RAG_ENABLE_LLM=false 时降级到模板回答。
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_ENABLE_LLM=true
# 生成 token 预算：推理型模型（如 deepseek-v4-flash）reasoning 计入 completion，需给足
DEEPSEEK_MAX_TOKENS=4000

# 检索参数
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
RAG_RECALL_TOP=20
RAG_BM25_WEIGHT=0.35
RAG_VECTOR_WEIGHT=0.35
RAG_RECENCY_WEIGHT=0.15
RAG_STATUS_WEIGHT=0.15

# 会话与历史
QA_HISTORY_TURNS=10
QA_SESSION_MAX_MESSAGES=200
QA_SESSION_LIST_DEFAULT_LIMIT=20
# 意图识别 agent（false 时所有问题都走 RAG）
QA_ENABLE_LLM_INTENT=true
# 意图 agent 模型（留空沿用 DEEPSEEK_CHAT_MODEL）
QA_INTENT_MODEL=
# 摘要正文存库硬上限（字符数）
QA_SUMMARY_MAX_CHARS=600

# === Aily MCP Server（详见 openspec/changes/add-aily-mcp-server）===
# 总开关：false 时 /mcp/sse 不挂载（与 /v1/* HTTP 契约解耦）
MCP_ENABLED=true
# SSE 端点路径（生产建议加随机 token 防扫描，如 /mcp/sse/<random>）
MCP_SSE_PATH=/mcp/sse
# MCP POST 消息端点路径（SSE 客户端回传用）
MCP_MESSAGES_PATH=/mcp/messages
# 注：原 MCP_ALLOW_INSECURE_USER_HEADER 已被删除（C1 修复）——
# MCP 是机器对机器，user identity 在 UI 层处理，不在 MCP 层 trust
