# LabMemory Platform 本地开发配置示例
# 复制为 .env 后按需修改

# 数据库：默认 SQLite 文件库（生产可切 postgresql://user:pwd@host:5432/labmemory）
DATABASE_URL=sqlite:///./data/labmemory.db

# 服务
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
LOG_LEVEL=INFO
CORS_ORIGINS=*

# 飞书编排器调用 /v1/* 接口的鉴权密钥（生产请至少 32 字符）
PLATFORM_API_KEY=dev-platform-api-key-please-rotate

# 平台用户 JWT 签名密钥（生产请至少 32 字符）
JWT_SECRET=dev-jwt-secret-please-rotate
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 飞书编排器地址（用于平台请求飞书侧执行 create_task 等动作）
FEISHU_ORCHESTRATOR_BASE_URL=http://localhost:8080
FEISHU_ORCHESTRATOR_MODE=mock
