# LabMemory Platform 本地开发配置示例
# 复制为 .env 后按需修改

# 数据库：默认 SQLite 文件库（生产可切 postgresql://user:pwd@host:5432/labmemory）
DATABASE_URL=sqlite:///./data/labmemory.db

# 服务
SERVER_HOST=0.0.0.0
SERVER_PORT=8081
LOG_LEVEL=INFO
CORS_ORIGINS=*

# 飞书编排器调用 /v1/* 接口的鉴权密钥（生产请至少 32 字符）
PLATFORM_API_KEY=dev-platform-api-key-please-rotate

# 平台用户 JWT 签名密钥（生产请至少 32 字符）
JWT_SECRET=dev-jwt-secret-please-rotate
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 飞书编排器地址（用于平台请求飞书侧执行 create_task 等动作）
FEISHU_ORCHESTRATOR_BASE_URL=http://localhost:8080
FEISHU_ORCHESTRATOR_MODE=mock

# === 可信知识问答 RAG ===
# Qwen 嵌入模型（DashScope 兼容 OpenAI 接口）。留空则降级到 hash 伪向量。
QWEN_API_KEY=
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_EMBEDDING_DIM=1024
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek 对话模型（兼容 OpenAI SDK）。留空或 RAG_ENABLE_LLM=false 时降级到模板回答。
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
RAG_ENABLE_LLM=true

# 检索参数
RAG_TOP_K=5
RAG_MIN_SCORE=0.25
RAG_RECALL_TOP=20
RAG_BM25_WEIGHT=0.35
RAG_VECTOR_WEIGHT=0.35
RAG_RECENCY_WEIGHT=0.15
RAG_STATUS_WEIGHT=0.15
