# ============================================
# LabMemory 飞书侧编排系统 - 环境变量模板
# ============================================

# 飞书应用配置
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书 Token（开发阶段可手动填写，生产用 Redis 缓存自动刷新）
FEISHU_TENANT_ACCESS_TOKEN=
FEISHU_USER_ACCESS_TOKEN=

# Aily 配置
AILY_API_BASE=https://aily.feishu.cn/api
AILY_SKILL_ID=skill_xxxxxxxxxxxx
AILY_API_KEY=xxxxxxxxxxxxxxxx

# LabMemory 平台配置
PLATFORM_API_BASE=https://labmemory.example.com/api
PLATFORM_API_KEY=xxxxxxxxxxxxxxxx

# 多维表格配置（协作台账）
BASE_APP_TOKEN=bascnxxxxxxxxxxxxxxxx
BASE_TABLE_ID=tblxxxxxxxxxxxxxx

# 卡片回调配置
CARD_CALLBACK_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxx
CARD_CALLBACK_ENCRYPT_KEY=xxxxxxxxxxxxxxxx

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=INFO

# 运行模式: real / mock
RUN_MODE=mock

# 重试配置
MAX_RETRIES=5
RETRY_BASE_DELAY=1
